# Copy to .env (ignored); inject actual secrets privately.
POSTGRES_PASSWORD=replace-with-random-database-secret
DATABASE_ADMIN_URL=postgresql://cimd:replace-with-random-database-secret@postgres:5432/cimd
DATABASE_URL=postgresql://cimd_runtime:replace-with-separate-runtime-secret@postgres:5432/cimd
OAUTH_ISSUER=https://auth.example.com
MCP_RESOURCE=https://mcp.example.com/mcp
INTROSPECTION_ENDPOINT=https://auth.example.com/oauth/introspect
OAUTH_SCOPES=agent.self.read catalog.read
RS_ID=reference-mcp
RS_SECRET=replace-with-at-least-32-random-secret-bytes
ADMISSION_POLICY=open_basic
ACCEPTED_CUSTODY_CONDITION=Operator-approved local encrypted signing key custody in the controlled reference environment
TOKEN_TTL_SECONDS=300
MAX_NEW_CLIENTS_HOUR=100
MAX_REQUESTS_CLIENT_MINUTE=10
MAX_REQUESTS_MINUTE=100
FETCH_GLOBAL_MINUTE=120
FETCH_ORIGIN_MINUTE=40
FETCH_CLIENT_MINUTE=20
FETCH_SOURCE_MINUTE=60
AS_TLS_DIRECTORY=/absolute/path/to/as-tls
RS_TLS_DIRECTORY=/absolute/path/to/rs-tls

# Optional standalone PAP Session demo; use PORT=9444 and independent HTTPS origin.
PAP_ORIGIN=https://pap-demo.example

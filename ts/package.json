{
  "name": "@agentconnect/cimd-oauth-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:postgres": "bash scripts/test-postgres.sh",
    "test:cache-window": "bash scripts/test-postgres.sh --cache-window",
    "test:independent-client": "bash scripts/test-postgres.sh --independent-client",
    "test:dsh-native": "bash scripts/test-postgres.sh --dsh-native",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "configure": "node --env-file-if-exists=.env --import tsx scripts/configure.ts",
    "start:as": "node --env-file-if-exists=.env --import tsx examples/authorization-server/main.ts",
    "start:mcp": "node --env-file-if-exists=.env --import tsx examples/minimal-mcp-server/main.ts",
    "identity:init": "node --env-file-if-exists=.env --import tsx examples/self-hosted-identity/init.ts",
    "start:identity": "node --env-file-if-exists=.env --import tsx examples/self-hosted-identity/main.ts",
    "admin": "node --env-file-if-exists=.env --import tsx scripts/admin.ts",
    "format:check": "prettier --check packages examples scripts tests docs package.json tsconfig.json compose.yaml",
    "test:independent-as": "NODE_ENV=test tsx --test tests/independent-as.component.ts",
    "test:independent-as-native": "bash scripts/test-independent-as-native.sh",
    "test:registered-publisher": "NODE_ENV=test tsx scripts/registered-publisher.ts",
    "test:identity-http": "bash scripts/test-postgres.sh --identity-http",
    "test:process-recovery": "bash scripts/test-postgres.sh --process-recovery",
    "test:shared-protocol": "bash scripts/test-postgres.sh --shared-protocol",
    "test:rotation-native": "bash scripts/test-postgres.sh --rotation-native",
    "test:mcp-product": "bash scripts/test-postgres.sh --mcp-product",
    "test:shared-product": "bash scripts/test-postgres.sh --shared-product",
    "start:as:built": "node --env-file-if-exists=.env dist/examples/authorization-server/main.js",
    "start:mcp:built": "node --env-file-if-exists=.env dist/examples/minimal-mcp-server/main.js",
    "migrate:built": "node --env-file-if-exists=.env dist/scripts/migrate.js",
    "configure:built": "node --env-file-if-exists=.env dist/scripts/configure.js",
    "admin:built": "node --env-file-if-exists=.env dist/scripts/admin.js",
    "pack:runtime": "node scripts/pack-runtime.mjs",
    "start:pap": "node --env-file-if-exists=.env --import tsx examples/minimal-pap-server/main.ts",
    "test:pap-demo": "NODE_ENV=test tsx scripts/pap-demo.ts",
    "start:combined": "node --env-file-if-exists=.env --import tsx examples/combined-server/cli.ts",
    "start:combined:built": "node --env-file-if-exists=.env dist/examples/combined-server/cli.js",
    "test:website": "bash scripts/test-postgres.sh --website",
    "test:website-native": "bash scripts/test-postgres.sh --website-native"
  },
  "dependencies": {
    "@awiki/anp-typescript-sdk": "0.9.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "5.3.0",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.19.15",
    "@types/pg": "8.16.0",
    "oauth4webapi": "3.8.8",
    "oidc-provider": "9.13.3",
    "prettier": "3.6.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0",
  "files": [
    "dist/packages/oauth-core",
    "dist/packages/oauth-as",
    "dist/packages/oauth-rs",
    "dist/packages/store-postgres",
    "dist/examples/authorization-server",
    "dist/examples/minimal-mcp-server",
    "dist/examples/self-hosted-identity",
    "dist/examples/config.js",
    "dist/scripts/migrate.js",
    "dist/scripts/configure.js",
    "dist/scripts/admin.js",
    "docs/runtime-package.md",
    "docs/dependency-licenses.json",
    ".env.example",
    "npm-shrinkwrap.json",
    "dist/packages/anp",
    "dist/packages/pap",
    "dist/packages/service-agent",
    "dist/examples/combined-server"
  ]
}

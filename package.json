{
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@awiki/anp-typescript-sdk": "0.9.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "5.3.0",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.19.15",
    "@types/pg": "8.16.0",
    "oauth4webapi": "3.8.8",
    "oidc-provider": "9.13.3",
    "prettier": "3.6.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "name": "@agentconnect/service-agent",
  "description": "ANP, MCP and PAP reference service with shared website operations",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentConnect/service-agent.git"
  },
  "exports": {
    ".": {
      "types": "./ts/dist/packages/service-agent/index.d.ts",
      "import": "./ts/dist/packages/service-agent/index.js"
    },
    "./website": {
      "types": "./ts/dist/packages/service-agent/website.d.ts",
      "import": "./ts/dist/packages/service-agent/website.js"
    },
    "./runtime": {
      "types": "./ts/dist/examples/combined-server/main.d.ts",
      "import": "./ts/dist/examples/combined-server/main.js"
    }
  },
  "files": [
    "ts/dist/packages",
    "ts/dist/examples",
    "LICENSE",
    "README.md",
    "ts/dist/scripts/migrate.js",
    "ts/dist/scripts/configure.js",
    "ts/dist/scripts/admin.js"
  ],
  "scripts": {
    "build": "tsc -p ts/tsconfig.json && node ts/scripts/copy-assets.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit -p ts/tsconfig.json",
    "test": "tsx --test ts/tests/*.test.ts"
  }
}
